/package.json
/package-lock.json
/tsconfig.json
/tsconfig.tsbuildinfo
/next.config.ts
/next-env.d.ts
/open-next.config.ts
/eslint.config.mjs
/vitest.config.ts
/middleware.ts
/.eslintignore
/.gitignore
/.assetsignore
/wrangler.toml
*.deploy-bak
# project docs and audit reports (not site content)
/*.md
