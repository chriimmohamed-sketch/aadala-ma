# Environment variables — AADALA.MA
# Copy to .env.local for local development. NEVER commit real values.

# AI provider (server-side only)
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=

# Database
DATABASE_URL=

# Auth (Supabase Auth)
# Server verifies sessions; the anon key is the ONLY key allowed in the client bundle.
# SUPABASE_SERVICE_ROLE_KEY is SECRET — server/backend scripts ONLY, never ship to the client.
# Admin enforcement happens server-side (RLS + role check); no public admin role exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=

# Optional: vector search (pgvector) — requires the apply_articles migration + embeddings build
# AI_VECTOR_SEARCH=1
