{
  "$comment": "Single source of truth for the AADALA design system. Edit here, then run: npm run design:fix",
  "prefix": "aadala",
  "colors": {
    "navy":          { "light": "#0B1D3A" },
    "navy-soft":     { "light": "#13294B" },
    "gold":          { "light": "#C9A227" },
    "gold-soft":     { "light": "#E6C96A" },
    "ivory":         { "light": "#F7F3EA", "dark": "#0B1D3A" },
    "ivory-deep":    { "light": "#EFE7D6", "dark": "#13294B" },
    "graphite":      { "light": "#2B2B2B", "dark": "#F7F3EA" },
    "graphite-soft": { "light": "#5A5A5A", "dark": "#C9C3B5" },
    "surface":       { "light": "#FFFFFF", "dark": "#13294B" },
    "border":        { "light": "#D9D2C3", "dark": "#2B4A7A" },
    "danger":        { "light": "#9B2C2C" },
    "success":       { "light": "#2F6B4F" },
    "teal":          { "light": "#0F5C52" },
    "bg":            { "light": "#F7F3EA", "dark": "#0B1D3A" },
    "muted":         { "light": "#5A5A5A", "dark": "#C9C3B5" }
  },
  "fonts": {
    "sans": "\"Tajawal\", \"Cairo\", \"IBM Plex Sans Arabic\", \"Noto Sans Arabic\", \"Segoe UI\", sans-serif",
    "display": "\"Reem Kufi\", \"Noto Kufi Arabic\", \"Amiri\", Tahoma, sans-serif",
    "body": "\"Tajawal\", \"Cairo\", \"IBM Plex Sans Arabic\", \"Noto Sans Arabic\", \"Segoe UI\", sans-serif"
  },
  "tailwindMap": {
    "text-amber-900": "text-graphite", "text-amber-800": "text-graphite", "text-amber-700": "text-graphite",
    "bg-amber-50": "bg-gold/10",     "bg-amber-100": "bg-gold/20",
    "border-amber-200": "border-gold/40", "border-amber-300": "border-gold/60", "border-amber-400": "border-gold",
    "text-slate-900": "text-graphite", "text-slate-800": "text-graphite", "text-slate-700": "text-graphite",
    "text-slate-600": "text-graphite-soft", "text-slate-500": "text-graphite-soft",
    "bg-slate-50": "bg-ivory", "bg-slate-100": "bg-ivory-deep", "border-slate-200": "border-border", "border-slate-300": "border-border",
    "bg-red-50": "bg-danger/10", "text-red-700": "text-danger", "text-red-800": "text-danger", "border-red-300": "border-danger/60",
    "bg-green-50": "bg-success/10", "text-green-700": "text-success", "text-green-800": "text-success",
    "bg-emerald-50": "bg-success/10", "text-emerald-700": "text-success", "text-emerald-800": "text-success"
  },
  "legacyBridge": {
    "--color-primary": "navy", "--color-primary-light": "navy-soft", "--color-primary-dark": "navy",
    "--color-accent": "gold", "--color-accent-light": "gold-soft", "--color-accent-dark": "gold",
    "--color-secondary": "teal", "--color-secondary-light": "teal",
    "--color-bg": "ivory", "--color-bg-alt": "surface", "--color-surface": "surface",
    "--color-text": "graphite", "--color-text-muted": "graphite-soft", "--color-border": "border",
    "--color-danger": "danger", "--color-success": "success"
  }
}
